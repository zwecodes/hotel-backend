# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (TiDB Cloud / MySQL) ─────────────────────────
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=hotel_system

# ── Authentication ────────────────────────────────────────
# Long random string — generate: openssl rand -base64 48
JWT_SECRET=

# Frontend origin(s) for CORS (comma-separated). Required for cookie auth.
CORS_ORIGIN=http://localhost:3000

# Used when building password-reset links and Stripe return URLs
FRONTEND_URL=http://localhost:3000

# ── Stripe (sandbox / test mode) ──────────────────────────
# Dashboard → Developers → API keys (use sk_test_...)
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint .../api/payments/webhook
# Listen with: stripe listen --forward-to localhost:5000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=
# Currency for Checkout (default thb — matches UI ฿)
STRIPE_CURRENCY=thb
